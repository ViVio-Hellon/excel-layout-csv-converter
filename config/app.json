{
  "app_id": "nlm.excel-csv-converter",
  "display_name": "エクセル → CSV 変換器",
  "version": "1.11.2",
  "monitor_level": 2,
  "local_dir_name": "ExcelCsvConverter",
  "log_name": "ExcelCsvConverter",

  "server": {
    "host": "127.0.0.1",
    "port": 8741
  },

  "limits": {
    "max_files": 100,
    "max_file_mb": 50
  },

  "monitoring": {
    "heartbeat_seconds": 3,
    "screen_timeout_seconds": 12,
    "job_poll_ms": 400,
    "idle_exit_minutes": 30
  },

  "lines": {
    "coil": ["LS"]
  },

  "defaults": {
    "input_dir": "",
    "output_dir": "",
    "line": "",
    "ref_dir": "",
    "stop_csv": "",
    "log_dir": ""
  }
}
