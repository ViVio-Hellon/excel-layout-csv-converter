@echo off
rem ===================================================================
rem  診断用の起動(基盤仕様書 2.1)
rem
rem  通常は Start.vbs を使ってください。こちらはコンソールを出したまま
rem  起動し、構成とログを画面に出します ── 「起動しない」ときに、
rem  どこで止まっているのかを見るためのものです。
rem ===================================================================
setlocal
cd /d "%~dp0"

set "PY=python"
where python >nul 2>nul || set "PY=py -3"

echo ==========================================================
echo   エクセル → CSV 変換器 ── 診断用の起動
echo ==========================================================
echo 使う Python: %PY%
%PY% --version
echo.

%PY% start_app.py --diagnose
set "CODE=%ERRORLEVEL%"

echo.
echo ----------------------------------------------------------
echo 終了コード: %CODE%
if "%CODE%"=="1" echo   1 = 実行環境が足りません(Python の版・vendor の有無)
if "%CODE%"=="3" echo   3 = すでに起動しています(2つ目は起動しません)
if "%CODE%"=="4" echo   4 = ポートを使えません(別のアプリが使っています)
echo ----------------------------------------------------------
pause
endlocal
